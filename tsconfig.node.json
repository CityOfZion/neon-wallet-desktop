{
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "lib": [
      "ESNext"
    ],
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ],
    },
    "types": [
      "electron-vite/node"
    ]
  },
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/shared/**/*",
    "src/shared/**/*.json",
    "src/preload/**/*",
    "sentry.config.ts",
    "package.json",
    "tailwind.config.ts"
  ]
}
