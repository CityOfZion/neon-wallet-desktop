{
  "name": "neon3",
  "version": "3.11.0",
  "description": "Everything a self-custodial wallet should be with everything you need to explore and make transactions in the Neo 3, Neo Legacy, Neo X, Bitcoin, Solana, Ethereum, EVMs and other blockchains.",
  "homepage": "https://github.com/CityOfZion/neon-wallet-desktop",
  "author": "COZ",
  "maintainers": [
    "COZ"
  ],
  "keywords": [],
  "license": "GPL-3.0-only",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "npx patch-package && electron-builder install-app-deps",
    "prepare": "husky",
    "lint": "eslint . --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "translate": "claude -p \"/translate\"",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "prebuild": "tsx scripts/check-env.ts",
    "build": "npm run typecheck && npm run lint && npm run prebuild && electron-vite build",
    "build:win": "npm run build && electron-builder --win --config",
    "build:mac": "npm run build && electron-builder --mac --config",
    "build:linux": "npm run build && electron-builder --linux --config",
    "create-release": "tsx scripts/create-release.ts",
    "generate-checksums": "tsx scripts/generate-checksums.ts",
    "playwright": "npm run build && npx playwright test",
    "playwright:headless": "npx playwright test",
    "playwright:ui": "npm run playwright -- --ui",
    "playwright:report": "npx playwright show-report",
    "icon": "svg-icons"
  },
