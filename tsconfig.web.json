{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "composite": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "paths": {
      "@renderer/*": [
        "./src/renderer/src/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ]
    },
    "resolveJsonModule": true,
    "strict": true
  },
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "./src/renderer/src/**/*",
    "./src/shared/**/*",
    "sentry.config.ts",
    "package.json"
  ],
}
